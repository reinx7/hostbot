# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3001
APP_DOMAIN=hostbot.app
NODE_ENV=development

# Auth.js / NextAuth
AUTH_SECRET=change-me-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_SERVER=smtp://user:password@smtp.example.com:587
EMAIL_FROM=HostBot <no-reply@hostbot.app>

# Database
DATABASE_URL=postgresql://hostbot:hostbot@localhost:5432/hostbot?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Docker
DOCKER_SOCKET_PATH=/var/run/docker.sock
BOT_UPLOAD_DIR=./storage/uploads
BOT_RUNTIME_DIR=./storage/runtime
MAX_UPLOAD_MB=150

# Security
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
JWT_INTERNAL_SECRET=change-me
