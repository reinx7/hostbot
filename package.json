{
  "name": "hostbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "worker:deploy": "tsx workers/deploy-worker.ts",
    "worker:metrics": "tsx workers/metrics-worker.ts",
    "ws": "tsx server/websocket.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker:deploy\" \"npm run worker:metrics\" \"npm run ws\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "zip": "bash scripts/create-zip.sh"
  },
  "dependencies": {
    "@auth/prisma-adapter": "latest",
    "@hookform/resolvers": "latest",
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-progress": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-tabs": "latest",
    "@radix-ui/react-toast": "latest",
    "@radix-ui/react-tooltip": "latest",
    "bcryptjs": "latest",
    "bullmq": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "dockerode": "latest",
    "framer-motion": "latest",
    "ioredis": "latest",
    "jsonwebtoken": "latest",
    "lucide-react": "latest",
    "next": "15.5.0",
    "next-auth": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-dropzone": "latest",
    "recharts": "latest",
    "sonner": "latest",
    "tailwind-merge": "latest",
    "zod": "latest",
    "ws": "latest",
    "yauzl": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "latest",
    "@types/dockerode": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "latest",
    "autoprefixer": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "eslint-config-next": "15.5.0",
    "postcss": "latest",
    "prisma": "^6.0.0",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
